{
  "builds": [
    { "src": "api/events.rs", "use": "@vercel/rust" },
    { "src": "api/webhook.rs", "use": "@vercel/rust" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/events", "dest": "api/events.rs" },
    { "src": "/api/webhook", "dest": "api/webhook.rs" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}